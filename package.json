{
  "name": "bhumisathi-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "e2e": "playwright test",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "eval:ai": "tsx --env-file-if-exists=.env.local scripts/eval-ai.ts",
    "db:start": "tsx scripts/local-db.ts start",
    "db:stop": "tsx scripts/local-db.ts stop",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:reset": "tsx --env-file-if-exists=.env.local scripts/reset-db.ts",
    "ai:spike": "tsx --env-file-if-exists=.env.local scripts/ai-spike.ts",
    "ai:g8": "tsx --env-file-if-exists=.env.local scripts/ai-g8.ts",
    "set-key": "tsx scripts/set-key.ts",
    "ai:models": "tsx --env-file-if-exists=.env.local scripts/ai-models.ts",
    "embed": "tsx --env-file-if-exists=.env.local scripts/embed.ts",
    "ai:g6": "tsx --env-file-if-exists=.env.local scripts/ai-g6.ts",
    "ai:vision": "tsx --env-file-if-exists=.env.local scripts/vision-spike.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@google/genai": "^3.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "next": "16.4.6",
    "postgres": "^4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "^17.11.0-beta.19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "supabase": "^3.1.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
