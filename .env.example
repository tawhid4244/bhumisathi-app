# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Sathi AI. AI_PROVIDER=anthropic; AI_CHAT_MODEL defaults to claude-opus-5-5;
# AI_EFFORT (low|medium|high) defaults to medium.
AI_PROVIDER=
AI_API_KEY=
AI_CHAT_MODEL=
AI_EFFORT=
# Gemini only: backup models when the main one is busy (comma-separated).
AI_FALLBACK_MODELS=
AI_VISION_MODEL=
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
SEAL_PRIVATE_KEY_ED25519=

# Postgres connection string. Leave EMPTY for local development: the app then uses the
# embedded PostgreSQL started by `npm run db:start`. For Supabase cloud, use the
# "Session pooler" connection string from Project Settings → Database.
DATABASE_URL=

# Auth (Task 16). `npm run users` generates both into .env.local; never commit them.
AUTH_SECRET=
DEMO_USER_PASSWORD=
