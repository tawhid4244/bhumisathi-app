# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Sathi AI. AI_PROVIDER = gemini (default model gemini-3.5-flash), anthropic (claude-opus-5-5)
# or mock (scripted answers, no key, no cost — fine for a first run). Save the key with
# `npm run set-key` (hidden input). AI_EFFORT (low|medium|high) defaults to medium.
AI_PROVIDER=
AI_API_KEY=
AI_CHAT_MODEL=
AI_EFFORT=
# Gemini only: backup models when the main one is busy (comma-separated).
AI_FALLBACK_MODELS=
AI_VISION_MODEL=
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# Postgres connection string. Leave EMPTY for local development: the app then uses the
# embedded PostgreSQL started by `npm run db:start`. For Supabase cloud, use the
# "Session pooler" connection string from Project Settings → Database.
DATABASE_URL=

# Auth and BhumiSeal (Tasks 16–17). `npm run users` generates these into .env.local; never commit them.
AUTH_SECRET=
SEAL_PRIVATE_KEY=
DEMO_USER_PASSWORD=

# Cloud (Task 19). `npm run set-db` saves CLOUD_DATABASE_URL (hidden input); `npm run vercel:env`
# writes .env.vercel.local for Vercel, where it becomes DATABASE_URL. Never commit either.
CLOUD_DATABASE_URL=
# Public address of the live site (QR codes on sealed reports point here).
SITE_URL=
# Set to "off" to disable the public judge-mode tour.
JUDGE_MODE=
