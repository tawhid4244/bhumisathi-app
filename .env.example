# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AI_PROVIDER=
AI_API_KEY=
AI_CHAT_MODEL=
AI_VISION_MODEL=
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
SEAL_PRIVATE_KEY_ED25519=

# Postgres connection string. Leave EMPTY for local development: the app then uses the
# embedded PostgreSQL started by `npm run db:start`. For Supabase cloud, use the
# "Session pooler" connection string from Project Settings → Database.
DATABASE_URL=
